{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "nyan-doom",
  "version": "1.5.5",
  "homepage": "https://github.com/andrikpowell/nyan-doom",
  "license": "GPL-2.0-only",
  "dependencies": [
    "libsndfile",
    {
      "name": "libzip",
      "default-features": false,
      "features": [
        "bzip2",
        "liblzma"
      ]
    },
    "sdl2",
    {
      "name": "sdl2-mixer",
      "features": [
        "fluidsynth",
        "libflac",
        "libmodplug",
        "mpg123",
        "opusfile"
      ]
    },
    "zlib"
  ],
  "features": {
    "discord-rpc": {
      "description": "Build with Discord Rich Presence support",
      "dependencies": [
        "discord-rpc"
      ]
    },
    "fluidsynth": {
      "description": "Build with FluidSynth support",
      "dependencies": [
        {
          "name": "fluidsynth",
          "default-features": false
        }
      ]
    },
    "libmad": {
      "description": "Build with libmad support",
      "dependencies": [
        "libmad"
      ]
    },
    "libspng": {
      "description": "Build with libspng support",
      "dependencies": [
        "libspng"
      ]
    },
    "libvorbis": {
      "description": "Build with vorbisfile support",
      "dependencies": [
        "libvorbis"
      ]
    },
    "libxmp": {
      "description": "Build with libxmp support",
      "dependencies": [
        {
          "name": "libxmp",
          "default-features": false
        }
      ]
    },
    "portmidi": {
      "description": "Build with PortMidi support",
      "dependencies": [
        "portmidi"
      ]
    }
  }
}
